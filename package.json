{
  "name": "hexo-site",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "node build-blog.cjs",
    "clean": "hexo clean",
    "deploy": "hexo deploy",
    "start": "npm run preview:starfield && npm run serve:starfield",
    "server": "npm start",
    "server:legacy": "hexo server --config _config.yml,_config.legacy-preview.yml",
    "prototype:stars": "node themes/hexo-theme-kira/prototypes/starfield/server.mjs",
    "prepare:starfield": "npm run preview:starfield",
    "preview:starfield": "node build-blog.cjs --preview",
    "generate:starfield": "hexo clean --config _config.yml,_config.stargazer-preview.yml && hexo --config _config.yml,_config.stargazer-preview.yml generate",
    "start:starfield": "npm start",
    "build:starfield": "npm run build",
    "build:legacy": "hexo clean --config _config.yml,_config.legacy.yml && hexo generate --bail --config _config.yml,_config.legacy.yml",
    "preview:legacy": "hexo clean --config _config.yml,_config.legacy-preview.yml && hexo generate --config _config.yml,_config.legacy-preview.yml",
    "serve:legacy": "node themes/stargazer-starfield/tools/preview-server.mjs --legacy",
    "test": "npm run preview:starfield && node --test tests/*.test.*",
    "serve:starfield": "node themes/stargazer-starfield/tools/preview-server.mjs",
    "netlify": "npm run build"
  },
  "hexo": {
    "version": "8.1.2"
  },
  "dependencies": {
    "hexo": "^8.0.0",
    "hexo-asset-img": "^1.2.0",
    "hexo-generator-archive": "^2.0.0",
    "hexo-generator-category": "^2.0.0",
    "hexo-generator-index": "^4.0.0",
    "hexo-generator-tag": "^2.0.0",
    "hexo-renderer-ejs": "^2.0.0",
    "hexo-renderer-marked": "^7.0.0",
    "hexo-renderer-pug": "^3.0.0",
    "hexo-renderer-stylus": "^3.0.1",
    "hexo-server": "^3.0.0",
    "hexo-tag-aplayer": "^3.0.4",
    "hexo-theme-kira": "^1.4.9",
    "hexo-theme-landscape": "^1.0.0",
    "hexo-util": "^3.3.0",
    "hexo-wordcount": "^6.0.1",
    "moment-timezone": "^0.6.0"
  }
}
