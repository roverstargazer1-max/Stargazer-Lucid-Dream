<%
  const posts = [];
  site.posts.each((post) => {
    posts.push(post);
  });
  posts.sort((left, right) => left.date.valueOf() - right.date.valueOf() || String(left.starry_id).localeCompare(String(right.starry_id)));
  const featured = posts.find((post) => post.starry_id === theme.featured_article_id) || posts[0] || null;
  const articlePath = featured ? url_for(featured.path) : '';
%>
<%- partial('partial/stage', { articlePath, articleTitle: featured?.title || '' }) %>
<main id="home-fallback" class="home-fallback" aria-labelledby="fallback-title">
  <p class="fallback-kicker"><%= config.title %></p>
  <div class="fallback-content">
    <% if (featured) { %>
      <h1 id="fallback-title">星空暂时休息一下</h1>
      <p class="fallback-message">星空暂时未能加载，请稍后刷新。</p>
      <div class="fallback-actions">
        <a class="fallback-retry" href="<%= url_for('/') %>">刷新页面</a>
        <a href="<%= url_for('journal/') %>">阅读手记</a>
        <a href="<%= url_for('pages/friends/') %>">拜访友链</a>
      </div>
      <details class="fallback-articles">
        <summary>先阅读文章<span aria-hidden="true">⌄</span></summary>
        <ul class="fallback-article-list"><% for (const post of posts) { %><li><a href="<%= url_for(post.path) %>"><%= post.title %></a></li><% } %></ul>
      </details>
    <% } else { %>
      <h1 id="fallback-title">星空正在等待第一篇文章</h1>
      <p class="fallback-message">新的故事会在这里亮起。</p>
    <% } %>
  </div>
</main>
