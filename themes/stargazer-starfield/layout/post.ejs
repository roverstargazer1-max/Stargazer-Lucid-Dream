<%
  const articlePath = url_for(page.path);
%>
<% if (page.starry_id) { %>
  <%- partial('partial/stage', { articlePath, articleTitle: page.title }) %>
  <main id="static-article-fallback" class="static-article-fallback">
    <article class="article" data-starry-id="<%= page.starry_id %>">
      <div class="article-meta"><time datetime="<%= date(page.date, 'YYYY-MM-DD') %>"><%= date(page.date, 'YYYY-MM-DD') %></time><span>观星者的清醒梦</span></div>
      <h1 id="reader-title"><%= page.title %></h1>
      <% if (page.subheading) { %><div class="article-media"><%- page.subheading %></div><% } %>
      <div id="reader-content"><%- starry_content(page) %></div>
      <% const relatedArticles = starry_related_articles(page); %>
      <section class="reading-relations" aria-label="作者确认的文章关联" <%= relatedArticles.length ? '' : 'hidden' %>>
        <% if (relatedArticles.length) { %><h2>相连的文章</h2><ul>
        <% for (const related of relatedArticles) { %><li>
          <a class="reading-relation-link" data-starry-article-id="<%= related.post.starry_id %>" href="<%= url_for(related.post.path) %>"><%= related.post.title %></a>
          <% if (related.reason) { %><p><%= related.reason %></p><% } %>
        </li><% } %></ul><% } %>
      </section>
    </article>
  </main>
<% } else { %>
  <main class="static-article-fallback generic-post">
    <article class="article">
      <div class="article-meta"><time datetime="<%= date(page.date, 'YYYY-MM-DD') %>"><%= date(page.date, 'YYYY-MM-DD') %></time></div>
      <h1><%= page.title %></h1>
      <div class="article-rule" aria-hidden="true"></div>
      <%- starry_content(page) %>
      <p><a href="<%= url_for('/') %>">回到窗边</a></p>
    </article>
  </main>
<% } %>
