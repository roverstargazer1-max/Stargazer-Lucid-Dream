<main id="world" aria-label="星空探索">
  <canvas id="sky" aria-hidden="true"></canvas>
  <div class="grain" aria-hidden="true"></div>
  <div id="star-targets"></div>
  <header class="masthead"><a id="brand" href="<%= url_for('/') %>" aria-label="观星者的清醒梦，回到窗边">
      <img class="wordmark" data-src="<%= url_for('images/branding/logo2.png') %>" width="1081" height="452" alt="" aria-hidden="true" draggable="false">
    </a></header>
  <section id="preview" class="preview observation-panel" aria-labelledby="preview-title" data-asset-root="<%= url_for('images/observation/') %>" hidden>
    <h2 id="preview-title" class="sr-only"></h2>
    <div class="observation-artboard">
      <img class="observation-waves" data-src="<%= url_for('images/observation/waves.png') %>" alt="" aria-hidden="true" draggable="false">
      <div class="observation-silhouette" aria-hidden="true">
        <img class="silhouette-still" data-src="<%= url_for('images/observation/silhouette.png') %>" alt="" draggable="false">
        <img class="silhouette-frames" data-src="<%= url_for('images/optimized/silhouette-walk-frames.webp') %>" alt="" draggable="false" decoding="async" hidden>
        <canvas hidden></canvas>
      </div>
      <div class="year-scale" role="group" aria-label="文章发布年份">
        <% for (let offset = -2; offset <= 2; offset++) { %>
        <div class="year-row<%= offset === 0 ? ' is-current' : '' %>">
          <span class="year-number asset-glyphs" aria-hidden="true"></span>
          <% if (offset === 0) { %><img class="year-arrow" data-src="<%= url_for('images/observation/year-pointer.png') %>" alt="" aria-hidden="true" draggable="false"><span class="year-unit asset-glyphs" data-glyph-text="YE" aria-hidden="true"></span><% } %>
        </div>
        <% } %>
      </div>
      <span class="observation-axis" aria-hidden="true"><img data-src="<%= url_for('images/observation/diamond.png') %>" alt="" draggable="false"><img data-src="<%= url_for('images/observation/diamond.png') %>" alt="" draggable="false"></span>
      <img class="observation-ticks" data-src="<%= url_for('images/observation/dial-ticks.png') %>" alt="" aria-hidden="true" draggable="false">
      <img class="observation-bracket" data-src="<%= url_for('images/observation/dial-bracket.png') %>" alt="" aria-hidden="true" draggable="false">
      <div class="observation-waveform" aria-hidden="true">
        <img data-src="<%= url_for('images/observation/waveform.png') %>" alt="" draggable="false">
        <canvas hidden></canvas>
      </div>
      <div class="observation-call" aria-hidden="true">
        <img data-src="<%= url_for('images/observation/starlink.png') %>" alt="" draggable="false">
        <span class="call-label"><img data-src="<%= url_for('images/observation/call-word.png') %>" alt="" draggable="false"><img class="call-underline" data-src="<%= url_for('images/observation/call-underline.png') %>" alt="" draggable="false"></span>
      </div>
      <div class="observation-labels" aria-hidden="true">
        <span class="asset-glyphs" data-glyph-text="Y-E"></span><span class="asset-glyphs" data-glyph-text="MO"></span>
        <span class="asset-glyphs" data-glyph-text="DAY"></span><img class="hour-label" data-src="<%= url_for('images/observation/hour-label.png') %>" alt="" draggable="false">
      </div>
      <img class="observation-slashes" data-src="<%= url_for('images/observation/date-boxes.png') %>" alt="" aria-hidden="true" draggable="false">
      <time id="preview-date" class="asset-glyphs observation-date"></time>
      <img class="observation-id" data-src="<%= url_for('images/observation/observation-id.png') %>" alt="" aria-hidden="true" draggable="false">
      <button id="deselect" type="button" aria-label="取消选择" title="取消选择"><img data-src="<%= url_for('images/observation/close.png') %>" alt="" draggable="false"></button>
      <div class="preview-bottom">
        <button id="read-button" type="button" disabled aria-label="进入阅读" aria-describedby="approach-status">
          <img class="read-rule" data-src="<%= url_for('images/observation/read-rule.png') %>" alt="" aria-hidden="true" draggable="false"><img class="read-label" data-src="<%= url_for('images/observation/read.png') %>" alt="READ" draggable="false">
        </button>
        <span id="approach-status" class="sr-only" aria-live="polite">再点星，阅读</span>
      </div>
    </div>
  </section>
  <div class="sky-polyhedron" aria-hidden="true"><img data-src="<%= url_for('images/observation/polyhedron.png') %>" alt="" draggable="false"><canvas hidden></canvas></div>
  <nav id="exploration-controls" class="exploration-controls navigation" aria-label="星空探索控制">
    <div class="mode-switch" role="group" aria-label="星空模式">
      <button id="relation-mode" type="button" aria-pressed="true">关联</button>
      <span aria-hidden="true">/</span>
      <button id="time-mode" type="button" aria-pressed="false">时间</button>
    </div>
    <button id="back-dock" class="icon-control" type="button" aria-label="返回上个停靠点" title="返回上个停靠点" disabled>
      <span class="navigation-art navigation-art-back" aria-hidden="true"><img data-src="<%= url_for('images/branding/right-icons.png') %>" width="147" height="89" alt="" draggable="false"></span>
    </button>
    <button id="home" class="icon-control" type="button" aria-label="回到窗边" title="回到窗边" hidden>
      <span class="navigation-art navigation-art-home" aria-hidden="true"><img data-src="<%= url_for('images/branding/right-icons.png') %>" width="147" height="89" alt="" draggable="false"></span>
    </button>
  </nav>
  <span id="time-cue" class="time-cue" role="status" hidden></span>
  <button id="journal-egg" class="scene-egg" type="button" aria-label="翻开屋顶手记" title="翻开屋顶手记">⌑<span>屋顶手记</span></button>
  <button id="signal-egg" class="signal-egg" type="button" aria-label="触碰远方信号" title="远方传来一点微光" hidden>⌁<span>远方信号</span></button>
  <button id="edge-guide" class="edge-guide" type="button" hidden aria-label="寻找附近的文章星">›</button>
</main>

<section id="room" aria-label="窗边">
  <div id="room-stage" class="room-stage">
    <picture>
      <source media="(max-width: 760px)" srcset="<%= url_for(theme.scene.room_mobile) %>">
      <img class="room-image" src="<%= url_for(theme.scene.room_desktop) %>" alt="夜色里的窗边，窗外是深蓝天空" fetchpriority="high">
    </picture>
    <button id="window-entry" type="button" aria-label="穿过窗户，进入星空" disabled></button>
      <svg class="window-invitation window-invitation-wide" viewBox="0 0 1672 941" aria-hidden="true" focusable="false">
        <defs><linearGradient id="window-light-wide" gradientUnits="userSpaceOnUse" x1="0" y1="700" x2="0" y2="90"><stop offset="0" stop-color="#c8dfec" stop-opacity="0"/><stop offset=".48" stop-color="#d4e5eb" stop-opacity=".75"/><stop offset="1" stop-color="#c8dfec" stop-opacity="0"/></linearGradient></defs>
        <g class="window-edge" fill="none" stroke="url(#window-light-wide)"><path d="M524 90V700 M1144 90V700"/></g>
        <g class="window-dust" fill="#d7e3e7">
          <circle cx="784" cy="363" r="1.8"/>
          <circle cx="813" cy="391" r="1.2"/>
          <circle cx="828" cy="347" r="1.5"/>
          <circle cx="765" cy="403" r="1.1"/>
          <path d="M805 349l1.3 4.7 3.7 1.3-3.7 1.3-1.3 4.7-1.3-4.7-3.7-1.3 3.7-1.3Z"/>
        </g>
      </svg>
      <svg class="window-invitation window-invitation-tall" viewBox="0 0 941 1672" aria-hidden="true" focusable="false">
        <defs><linearGradient id="window-light-tall" gradientUnits="userSpaceOnUse" x1="0" y1="920" x2="0" y2="45"><stop offset="0" stop-color="#c8dfec" stop-opacity="0"/><stop offset=".48" stop-color="#d4e5eb" stop-opacity=".75"/><stop offset="1" stop-color="#c8dfec" stop-opacity="0"/></linearGradient></defs>
        <g class="window-edge" fill="none" stroke="url(#window-light-tall)"><path d="M190 45V920"/></g>
        <g class="window-dust" fill="#d7e3e7">
          <circle cx="521" cy="475" r="3.5"/>
          <circle cx="567" cy="515" r="2.2"/>
          <circle cx="590" cy="450" r="2.8"/>
          <circle cx="501" cy="535" r="2"/>
          <path d="M547 455l2.2 8.8 6.8 2.2-6.8 2.2-2.2 8.8-2.2-8.8-6.8-2.2 6.8-2.2Z"/>
        </g>
      </svg>
      
    <button id="room-journal" type="button" aria-label="翻开桌上的手记" title="桌上的手记"></button>
  </div>
</section>

<dialog id="reader" aria-labelledby="reader-title">
  <div class="reading-frame">
    <header class="reading-header">
      <span id="reading-window-title" class="sr-only">观星者的清醒梦</span>
      <button id="close-reader" type="button" aria-label="关闭文章，返回星空" title="关闭文章，返回星空">
        <img data-src="<%= url_for('images/observation/close.png') %>" alt="" draggable="false">
      </button>
    </header>
    <div id="reading-scroll" tabindex="0"><div id="reading-content-slot"></div></div>
    <footer class="reading-footer">
      <div id="reading-journey" role="progressbar" aria-label="文章阅读进度" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
        <div class="reading-rail" aria-hidden="true"><span class="reading-rail-fill"></span></div>
        <div class="reading-walker" aria-hidden="true">
          <img class="silhouette-frames" data-src="<%= url_for('images/optimized/silhouette-walk-frames.webp') %>" alt="" hidden>
          <canvas hidden></canvas>
        </div>
        <span id="reading-progress">0%</span>
        <span class="reading-track-label" aria-hidden="true">阅读</span>
      </div>
      <span id="reading-state" class="sr-only">沿着文字，慢慢往下</span>
    </footer>
  </div>
</dialog>
<dialog id="collection-panel" aria-labelledby="collection-panel-title">
  <div class="collection-frame">
    <header class="collection-header">
      <div><h2 id="collection-panel-title">文章清单</h2></div>
      <button id="close-collection" type="button">回到星空</button>
    </header>
    <div id="collection-scroll" tabindex="0"><div id="collection-content-slot"></div></div>
  </div>
</dialog>
<dialog id="egg-dialog"><button id="close-egg" class="egg-close" type="button" aria-label="关闭">×</button><span class="eyebrow">A NOTE FROM THE ROOFTOP</span><h2 id="egg-title"></h2><p id="egg-copy"></p><span class="egg-signature">来自这片天空的主人</span></dialog>
<div id="announcement" class="sr-only" role="status" aria-live="polite"></div>

<script type="module" src="<%= url_for('js/starfield/app.js') %>" onerror="window.starfieldStartup?.fail()"></script>
