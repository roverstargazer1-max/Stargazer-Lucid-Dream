<main id="world" aria-label="星空探索">
  <canvas id="sky" aria-hidden="true"></canvas>
  <div class="grain" aria-hidden="true"></div>
  <div id="star-targets"></div>
  <header class="masthead"><a id="brand" href="<%= url_for('/') %>" aria-label="观星者的清醒梦，回到窗边">
      <svg class="wordmark" viewBox="0 0 460 160" aria-hidden="true" focusable="false">
        <g fill="currentColor" font-family="Baskerville Old Face, Baskerville, Times New Roman, serif" font-weight="400">
          <text x="10" y="63" font-size="68" letter-spacing="-2">Stargazer’s</text>
          <text x="109" y="122" font-size="57" letter-spacing="-2" font-style="italic">Lucid Dream</text>
        </g>
        <g fill="none" stroke="currentColor" stroke-width="1.1" opacity=".8"><path d="M35 64 C12 106 61 122 132 137 S262 158 309 134"/><path d="M122 136 C90 126 77 134 89 145 C101 155 135 151 142 138"/></g>
        <path d="M342 12 L344 24 L353 27 L344 30 L342 42 L340 30 L331 27 L340 24Z M169 132 L170.5 138 L176 140 L170.5 142 L169 148 L167.5 142 L162 140 L167.5 138Z" fill="currentColor"/>
        <circle cx="358" cy="41" r="1.25" fill="currentColor"/>
      </svg>
    </a></header>
  <section id="preview" class="preview" aria-label="文章与探索入口" hidden>
      <div class="preview-meta"><span id="preview-number"></span><time id="preview-date"></time><button id="deselect" type="button" aria-label="取消选择">×</button></div>
    <div id="preview-scroll" class="preview-scroll" tabindex="0" role="region" aria-label="文章标题与关联理由">
    <div class="preview-body">
      <h2 id="preview-title"></h2>
      <p id="mode-note" class="mode-note" hidden></p>
      <section id="relation-cues" class="relation-cues" aria-label="文章探索关系" hidden>
        <p class="relation-legend">细实线：邻近探索 · 虚线：作者确认关联</p>
        <div id="relation-links" class="relation-links"></div>
      </section>
      <section id="known-reasons" class="known-reasons" aria-label="已读文章的作者关联理由" hidden></section>
    </div>
    </div>
    <div class="preview-bottom">
      <span id="approach-status" aria-live="polite">再点星，阅读</span>
      <button id="read-button" type="button" disabled>进入阅读 <span aria-hidden="true">↗</span></button>
    </div>
  </section>
  <nav id="exploration-controls" class="exploration-controls navigation" aria-label="星空探索控制">
    <div class="mode-switch" role="group" aria-label="星空模式">
      <button id="relation-mode" type="button" aria-pressed="true">关联</button>
      <span aria-hidden="true">/</span>
      <button id="time-mode" type="button" aria-pressed="false">时间</button>
    </div>
    <button id="back-dock" class="icon-control" type="button" aria-label="返回上个停靠点" title="返回上个停靠点" disabled>↶</button>
    <button id="home" class="icon-control" type="button" aria-label="回到窗边" title="回到窗边" hidden>⌂</button>
    <button id="motion-toggle" class="motion-toggle" type="button" aria-pressed="false" aria-label="减少镜头动画">镜头推进</button>
  </nav>
  <span id="time-cue" class="time-cue" role="status" hidden></span>
  <button id="journal-egg" class="scene-egg" type="button" aria-label="翻开屋顶手记" title="翻开屋顶手记">⌑<span>屋顶手记</span></button>
  <button id="signal-egg" class="signal-egg" type="button" aria-label="触碰远方信号" title="远方传来一点微光">⌁<span>远方信号</span></button>
  <button id="edge-guide" class="edge-guide" type="button" hidden aria-label="寻找附近的文章星">›</button>
  <span id="path-legend" class="path-legend">虚线：探索路径</span>
  <p id="gesture-help">拖动巡视 · 滚轮前行 · 点星靠近</p>
</main>

<section id="room" aria-label="窗边">
  <div id="room-stage" class="room-stage">
    <picture>
      <source media="(max-width: 760px)" srcset="<%= url_for(theme.scene.room_mobile) %>">
      <img class="room-image" src="<%= url_for(theme.scene.room_desktop) %>" alt="夜色里的窗边，窗外是深蓝天空">
    </picture>
    <button id="window-entry" type="button" aria-label="穿过窗户，进入星空"></button>
      <svg class="window-invitation window-invitation-wide" viewBox="0 0 1672 941" aria-hidden="true" focusable="false">
        <defs><linearGradient id="window-light-wide" gradientUnits="userSpaceOnUse" x1="0" y1="700" x2="0" y2="90"><stop offset="0" stop-color="#c8dfec" stop-opacity="0"/><stop offset=".48" stop-color="#d4e5eb" stop-opacity=".75"/><stop offset="1" stop-color="#c8dfec" stop-opacity="0"/></linearGradient></defs>
        <g class="window-edge" fill="none" stroke="url(#window-light-wide)"><path d="M524 90V700 M1144 90V700"/></g>
        <g class="window-dust" fill="#d7e3e7">
          <circle cx="784" cy="363" r="1.8"/>
          <circle cx="813" cy="391" r="1.2"/>
          <circle cx="828" cy="347" r="1.5"/>
          <circle cx="765" cy="403" r="1.1"/>
          <path d="M805 349l1.3 4.7 3.7 1.3-3.7 1.3-1.3 4.7-1.3-4.7-3.7-1.3 3.7-1.3Z"/>
        </g>
      </svg>
      <svg class="window-invitation window-invitation-tall" viewBox="0 0 941 1672" aria-hidden="true" focusable="false">
        <defs><linearGradient id="window-light-tall" gradientUnits="userSpaceOnUse" x1="0" y1="920" x2="0" y2="45"><stop offset="0" stop-color="#c8dfec" stop-opacity="0"/><stop offset=".48" stop-color="#d4e5eb" stop-opacity=".75"/><stop offset="1" stop-color="#c8dfec" stop-opacity="0"/></linearGradient></defs>
        <g class="window-edge" fill="none" stroke="url(#window-light-tall)"><path d="M190 45V920"/></g>
        <g class="window-dust" fill="#d7e3e7">
          <circle cx="521" cy="475" r="3.5"/>
          <circle cx="567" cy="515" r="2.2"/>
          <circle cx="590" cy="450" r="2.8"/>
          <circle cx="501" cy="535" r="2"/>
          <path d="M547 455l2.2 8.8 6.8 2.2-6.8 2.2-2.2 8.8-2.2-8.8-6.8-2.2 6.8-2.2Z"/>
        </g>
      </svg>
      
    <button id="room-journal" type="button" aria-label="翻开桌上的手记" title="桌上的手记"></button>
  </div>
  <button id="entry-motion" class="entry-motion" type="button" aria-pressed="false">轻过渡</button>
</section>

<dialog id="reader" aria-labelledby="reader-title">
  <div class="reading-frame">
    <header class="reading-header">
      <span class="reading-site">
        <svg class="window-icon" viewBox="0 0 16 16" aria-hidden="true" shape-rendering="crispEdges"><path fill="currentColor" d="M7 0h2v5h2v2h5v2h-5v2H9v5H7v-5H5V9H0V7h5V5h2z"/><path fill="#7373a1" d="M7 7h2v2H7z"/></svg>
        <span id="reading-window-title" class="window-title">观星者的清醒梦</span>
      </span>
      <button id="close-reader" type="button" aria-label="关闭文章，返回星空" title="关闭文章，返回星空">
        <svg class="window-close-icon" viewBox="0 0 16 16" aria-hidden="true" shape-rendering="crispEdges"><path fill="currentColor" d="M2 2h3v1h1v1h1v1h2V4h1V3h1V2h3v2h-1v1h-1v1h-1v1h-1v2h1v1h1v1h1v1h1v2h-3v-1h-1v-1H9v-1H7v1H6v1H5v1H2v-2h1v-1h1v-1h1V9h1V7H5V6H4V5H3V4H2z"/></svg>
      </button>
    </header>
    <div id="reading-scroll" tabindex="0"><div id="reading-content-slot"></div></div>
    <footer class="reading-footer"><span id="reading-state">沿着文字，慢慢往下</span><span id="reading-progress">0%</span></footer>
  </div>
</dialog>
<dialog id="collection-panel" aria-labelledby="collection-panel-title">
  <div class="collection-frame">
    <header class="collection-header">
      <div><span class="calendar-kicker">星空里的旧入口</span><h2 id="collection-panel-title">文章清单</h2></div>
      <button id="close-collection" type="button">回到星空</button>
    </header>
    <div id="collection-scroll" tabindex="0"><div id="collection-content-slot"></div></div>
  </div>
</dialog>
<dialog id="egg-dialog"><button id="close-egg" class="egg-close" type="button" aria-label="关闭">×</button><span class="eyebrow">A NOTE FROM THE ROOFTOP</span><h2 id="egg-title"></h2><p id="egg-copy"></p><span class="egg-signature">来自这片天空的主人</span></dialog>
<div id="announcement" class="sr-only" role="status" aria-live="polite"></div>

<script type="module" src="<%= url_for('js/starfield/app.js') %>"></script>
