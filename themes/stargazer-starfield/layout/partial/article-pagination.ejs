<% const adjacent = starry_adjacent_articles(page); %>
<% if (adjacent.previous || adjacent.next) { %>
<nav class="article-pagination" aria-label="按发表时间阅读相邻文章">
  <% for (const direction of ['previous', 'next']) { const post = adjacent[direction]; if (!post) continue; %>
  <a class="article-pagination-link article-pagination-<%= direction %>"
     data-starry-article-id="<%= post.starry_id %>" href="<%= url_for(post.path) %>" rel="<%= direction === 'previous' ? 'prev' : 'next' %>">
    <span class="article-pagination-label"><span class="article-pagination-arrow" aria-hidden="true"><%= direction === 'previous' ? '←' : '→' %></span><%= direction === 'previous' ? '上一篇' : '下一篇' %></span>
    <span class="article-pagination-title"><%= post.title %></span>
    <time class="article-pagination-date" datetime="<%= date(post.date, 'YYYY-MM-DD') %>"><%= date(post.date, 'YYYY-MM-DD') %></time>
  </a>
  <% } %>
</nav>
<% } %>
