<% const entryGeometry = starry_search_entry_geometry(); %>
<button id="search-entry" type="button" aria-label="展开星图检索" title="星图检索" aria-controls="star-search" style="--entry-pivot-x:<%= entryGeometry.pivot[0] / entryGeometry.size[0] * 100 %>%;--entry-pivot-y:<%= entryGeometry.pivot[1] / entryGeometry.size[1] * 100 %>%;--entry-native-angle:<%= entryGeometry.nativeAzimuth %>rad" hidden>
  <span class="search-entry-disc" style="clip-path:<%= entryGeometry.discClip %>" aria-hidden="true">
    <img style="clip-path:<%= entryGeometry.discWithoutNeedleClip %>" data-src="<%= starry_interface_url('images/optimized/entry-base.webp') %>" data-srcset="<%= starry_interface_srcset('images/optimized/entry-base.webp') %>" data-sizes="(max-height:650px) and (orientation:landscape) 60px, (max-width:760px) and (orientation:portrait) 72px, 100px" alt="" draggable="false">
    <img class="search-entry-repair" style="clip-path:<%= entryGeometry.repairClip %>" data-src="<%= starry_interface_url('images/optimized/entry-repair.webp') %>" data-srcset="<%= starry_interface_srcset('images/optimized/entry-repair.webp') %>" data-sizes="(max-height:650px) and (orientation:landscape) 60px, (max-width:760px) and (orientation:portrait) 72px, 100px" alt="" draggable="false">
  </span>
  <img class="search-entry-needle" style="clip-path:<%= entryGeometry.needleClip %>" data-src="<%= starry_interface_url('images/optimized/entry-base.webp') %>" data-srcset="<%= starry_interface_srcset('images/optimized/entry-base.webp') %>" data-sizes="(max-height:650px) and (orientation:landscape) 60px, (max-width:760px) and (orientation:portrait) 72px, 100px" alt="" draggable="false">
  <img class="search-entry-pivot" data-src="<%= starry_interface_url('images/optimized/entry-base.webp') %>" data-srcset="<%= starry_interface_srcset('images/optimized/entry-base.webp') %>" data-sizes="(max-height:650px) and (orientation:landscape) 60px, (max-width:760px) and (orientation:portrait) 72px, 100px" alt="" draggable="false">
</button>
<dialog id="star-search" aria-label="星图与文章检索" data-index-open="false" data-search-url="<%= url_for('starry/search.json') %>" data-glyph-root="<%= url_for('images/observation/') %>" data-filter-src="<%= url_for('images/search/filters-v3.png') %>">
  <div class="search-artboard" data-index-open="false">
    <div class="search-background" aria-hidden="true">
      <img class="search-base" data-search-src="<%= starry_interface_url('images/search/base-v3.png') %>" alt="" draggable="false">
    </div>
    <div class="search-primary">
    <h2 class="search-heading"><span class="sr-only">STAR CHART · 星图</span><img data-search-src="<%= url_for('images/search/star-chart-v3.png') %>" alt="" draggable="false"></h2>
    <form class="search-bar" role="search">
      <img class="search-frame" data-search-src="<%= starry_interface_url('images/search/frame-v3.png') %>" alt="" draggable="false">
      <img class="search-frame-background" data-search-src="<%= starry_interface_url('images/search/frame-background-v3.png') %>" alt="" draggable="false">
      <span class="search-submit-art" aria-hidden="true"><img data-search-src="<%= url_for('images/search/magnifier-v3.png') %>" alt="" draggable="false"></span>
      <label class="sr-only" for="search-query">检索文章标题、标签、正文或星表号</label>
      <input id="search-query" type="search" autocomplete="off" placeholder="" spellcheck="false">
      <button class="search-submit" type="submit" aria-label="检索文章" title="检索文章"></button>
    </form>
    <div class="search-filters" aria-label="文章筛选">
      <% for (const [kind, label] of [['year', '年份'], ['magnitude', '星等']]) { %>
      <div class="search-filter-row" data-filter="<%= kind %>" role="group" aria-label="按<%= label %>筛选，同一选项再次点击可取消">
        <span class="search-filter-label search-filter-label-<%= kind %>" aria-hidden="true"><img data-search-src="<%= url_for('images/search/filters-v3.png') %>" alt="" draggable="false"></span>
        <div class="search-filter-options"></div>
      </div>
      <% } %>
    </div>
    <div class="search-map" aria-label="全部文章的星位与当前视野">
      <canvas aria-hidden="true"></canvas>
      <div class="search-map-stars"></div>
      <span class="search-map-title" hidden></span>
    </div>
    </div>
    <button id="search-index-toggle" type="button" aria-label="展开检索索引" aria-expanded="false" aria-controls="search-index">
      <span class="search-toggle-feedback" aria-hidden="true"><img class="search-toggle-arrow" data-search-src="<%= url_for('images/search/arrow-v3.png') %>" alt="" draggable="false"></span>
    </button>
    <img class="search-index-heading" data-search-src="<%= url_for('images/search/index-v3.png') %>" alt="" draggable="false">
    <section id="search-index" aria-label="文章索引" hidden>
      <img class="search-index-mobile-heading" data-search-src="<%= url_for('images/search/index-v3.png') %>" alt="" aria-hidden="true" draggable="false">
      <div class="search-index-columns" aria-hidden="true"><img class="search-name-heading" data-search-src="<%= url_for('images/search/name-v3.png') %>" alt="" draggable="false"><img class="search-id-heading" data-search-src="<%= url_for('images/search/id-v3.png') %>" alt="" draggable="false"></div>
      <div id="search-results" tabindex="0"></div>
      <p id="search-feedback" role="status" aria-live="polite"></p>
      <button id="search-clear" type="button" hidden>清除条件</button>
    </section>
  </div>
  <button id="close-search" class="exit-control" type="button" autofocus aria-label="关闭检索，返回星空" title="返回星空"><img data-search-src="<%= url_for('images/search/close-v3.png') %>" alt="" draggable="false"></button>
</dialog>
