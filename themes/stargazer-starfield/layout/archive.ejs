<main class="static-article-fallback generic-post">
  <article class="article">
    <h1><%= page.category || page.tag || (page.year ? `${page.year}${page.month ? ` 年 ${page.month} 月` : ' 年'}` : '文章归档') %></h1>
    <div class="article-rule" aria-hidden="true"></div>
    <ol class="archive-list">
      <% page.posts.each((post) => { %>
        <li><time><%= date(post.date, 'YYYY-MM-DD') %></time><a href="<%= url_for(post.path) %>"><%= post.title %></a></li>
      <% }) %>
    </ol>
  </article>
</main>
