// 昼夜双主题 token
// 浅色值放在裸 :root，只有暗色走 html[data-theme='dark']，
// 这样即使切换脚本没跑起来也会退化成浅色，而不是退化成无样式。
//
// 注意：本文件只能被 layout.styl 导入一次。
// Stylus 的 @import 不去重，而 constants.styl 被五个文件导入，
// 从那里导入会让 :root 在输出 CSS 里出现五份。
:root {
	// —— 外观滑块（见 js/kira-opacity.js，两个模式共用）——
	--kira-surface-alpha: 0.78; // 内容面板不透明度，越大正文越清晰
	--kira-bg-opacity: 0.61; // 背景图透明度滑块的默认显示强度

	--kira-primary: $color1;

	--kira-surface-rgb: 255, 255, 255; // 主面板底色
	--kira-inset-rgb: 0, 0, 0; // 面板内的浅色块
	--kira-inset-alpha: 0.035;

	--kira-text-1: #111; // 标题
	--kira-text-2: #444; // 正文
	--kira-text-3: #5a6169; // 次要：引用、侧栏菜单与链接
	--kira-text-4: #999; // 更弱：分页、del、引号

	--kira-border: #eee;
	--kira-border-strong: #ccc; // hr 虚线
	--kira-hr: rgba(135, 135, 135, 0.3);

	--kira-hover: rgba(0, 0, 0, 0.08);
	--kira-shadow: rgba(138, 151, 174, 0.4);

	--kira-fab-color: rgb(85, 85, 85);
	--kira-fab-bg: rgba(255, 255, 255, 0.501);
	--kira-fab-bg-hover: rgba(255, 255, 255, 0.8);
	--kira-fab-bg-solid: rgba(255, 255, 255, 1);
	--kira-panel-bg: rgba(255, 255, 255, 0.92);

	--kira-list-ring: #fff; // article li::before 的描边，需贴合面板底色
	--kira-cover-placeholder: #eee;
	--kira-checkbox-bg: #ffffff;
	--kira-checkbox-border: #d9d9d9;
}

// 这里不要覆盖 --kira-surface-alpha / --kira-bg-opacity：
// kira-opacity.js 每次加载都会把它们写成 documentElement 的内联样式，
// 内联样式优先级高于任何样式表规则，写了也不会生效。
html[data-theme='dark'] {
	--kira-surface-rgb: 24, 26, 32;
	--kira-inset-rgb: 255, 255, 255;
	--kira-inset-alpha: 0.06;

	--kira-text-1: #f0f2f5;
	--kira-text-2: #c9ced6;
	--kira-text-3: #9aa3af;
	--kira-text-4: #7b828c;

	--kira-border: rgba(255, 255, 255, 0.12);
	--kira-border-strong: rgba(255, 255, 255, 0.18);
	--kira-hr: rgba(255, 255, 255, 0.14);

	--kira-hover: rgba(255, 255, 255, 0.1);
	--kira-shadow: rgba(0, 0, 0, 0.55);

	--kira-fab-color: #d6dae0;
	--kira-fab-bg: rgba(40, 44, 52, 0.72);
	--kira-fab-bg-hover: rgba(40, 44, 52, 0.9);
	--kira-fab-bg-solid: rgba(40, 44, 52, 0.95);
	--kira-panel-bg: rgba(30, 33, 40, 0.94);

	--kira-list-ring: transparent;
	--kira-cover-placeholder: #23262e;
	--kira-checkbox-bg: #2a2e37;
	--kira-checkbox-border: rgba(255, 255, 255, 0.24);
}
