.kira-right-column {
	width: 80px;
	height: 100vh;
	display: flex;
	flex-direction: column;
	align-items: center;
	// 按钮之间的统一间距。用 gap 而不是相邻兄弟选择器：
	// .kira-backtotop 的选择器权重比 `> * + *` 高，margin 方案会被它压掉
	gap: 12px;
	position: sticky;
	pointer-events: none;
	top: 0;
	z-index: 10;

	// 整列只留 .kira-opacity 一个 margin-top: auto，
	// 由它吸收全部剩余空间把按钮一起顶到底部。
	// 这里再来一个 auto 会把剩余空间分成两份，导致按钮被拉开
	.kira-backtotop {
		bottom: 20px;
		color: var(--kira-fab-color);
		background-color: var(--kira-fab-bg);
		border-radius: 50%;
		margin-bottom: 15px;
		transition: 500ms;
		pointer-events: all;

		i {
			font-size: 22px;
		}
	}
}
