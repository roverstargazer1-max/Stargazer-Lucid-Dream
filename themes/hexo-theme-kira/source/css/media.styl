@import 'constants.styl';

// 响应式布局
@media (max-width: 1180px) {
	.kira-sidebar {
		left: 0;
	}

	.kira-content {
		margin-right: auto;
	}

	.kira-right-column {
		position: fixed;
		top: 0;
		right: 0;

		// 右侧栏变 fixed 后直接压在背景图上，半透明按钮会看不清
		.kira-backtotop,
		.kira-theme-toggle {
			background-color: var(--kira-fab-bg-solid);
		}
	}
}

@media (max-width: 1120px) {
	.kira-body::-webkit-scrollbar {
		width: 0;
	}
}

@media (max-width: 1000px) {
	body {
		height: fit-content;
		overflow: auto;

		.kira-header {
			height: 60px;
			padding: 10px 16px;
			display: flex;
			align-items: center;
			justify-content: space-between;
			position: relative;
			z-index: 4;

			.kira-drawer-button {
				width: 45px;
				height: 45px;
				text-align: center;
				border-radius: 50%;
				transition: all 0.5s ease;
				display: flex;
				align-items: center;
				justify-content: center;
				color: var(--kira-text-1);

				i {
					font-size: 25px;
					line-height: 45px;
				}

				&:hover {
					background-color: var(--kira-hover);
				}
			}

			.kira-header-right {
				display: flex;
				align-items: center;
				gap: 8px;
			}

			.kira-header-theme-toggle {
				width: 40px;
				height: 40px;
				border: none;
				border-radius: 50%;
				background: transparent;
				color: var(--kira-text-1);
				display: flex;
				align-items: center;
				justify-content: center;
				cursor: pointer;
				transition: all 0.3s ease;

				&:hover {
					background-color: var(--kira-hover);
					color: $color1;
				}
			}

			.kira-header-avatar {
				width: 45px;
				height: 45px;
				text-align: center;
				border-radius: 50%;
				transition: all 0.5s ease;
				display: block;

				img {
					width: 100%;
					height: 100%;
					border-radius: 50%;
				}

				&:hover {
					background-color: var(--kira-hover);
				}
			}
		}

		.kira-body {
			height: fit-content;
			overflow: visible;

			.kira-sidebar {
				position: fixed;
				top: 0;
				left: 0;
				z-index: 16;
				transform: translateX(-100%);
				background-color: $surface;
				-webkit-backdrop-filter: $blurBg;
				backdrop-filter: $blurBg;

				&.show {
					transform: translateX(0%);
					width: calc(100% - 56px);
				}

				&-modal.show {
					pointer-events: auto;
					background-color: rgba(0, 0, 0, 0.4);
				}
			}

			.kira-content {
				#kira-top-header {
					top: calc(-2vh - 80px);
				}

				margin-right: unset;
				max-width: 100vw;
				margin-top: 0;
			}

			.kira-right-column {
				position: fixed;
				top: auto;
				bottom: 20px;
				right: 16px;
				width: auto;
				height: auto;
				z-index: 10;
				gap: 0;

				.kira-opacity,
				.kira-theme-toggle {
					display: none !important;
				}

				.kira-backtotop {
					margin-bottom: 0;
					bottom: auto;
					width: 42px;
					height: 42px;
					border-radius: 50%;
					box-shadow: 0 2px 12px rgba(0, 0, 0, 0.18);
					background-color: var(--kira-fab-bg-solid);
					display: flex;
					align-items: center;
					justify-content: center;

					button {
						width: 42px;
						height: 42px;
						min-width: 42px;
						line-height: 42px;
						box-shadow: none;
						display: flex;
						align-items: center;
						justify-content: center;
					}

					i {
						font-size: 18px;
						line-height: 1;
					}
				}
			}
		}
	}
	body::-webkit-scrollbar {
		width: 0;
	}
}

@media (max-width: 756px) {
	.kira-archives .categories {
		grid-template-columns: repeat(2, 98% / 2);
		grid-column-gap: 2%;
	}
}

@media (max-width: 400px) {
	.kira-archives .categories {
		grid-template-columns: repeat(1, 100%);
	}
}
