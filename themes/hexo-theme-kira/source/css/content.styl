.kira-content {
	position: relative;
	max-width: 860px;
	height: fit-content;
	flex-grow: 1;
	overflow: auto;
	scrollbar-width: none;
	box-shadow: 0 0 1rem var(--kira-shadow);
	margin-top: 2vh;
	margin-bottom: 2vh;

	.kira-main-content {
		position: relative;
		background-color: $surface;
		max-width: 100%;
		padding: 25px;
		min-height: 96vh;

		.aplayer {
			background: $surfaceCard;
		}

		.kira-page-nav {
			list-style: none;
			text-align: center;
			display: flex;
			color: var(--kira-text-4);
			background-color: $surfaceInset;
			border-radius: $radius;
			justify-content: center;

			.page-number {
				transition: 300ms;
				margin-inline: 10px;
			}

			.current {
				color: #fff;
				background: $color1;
				opacity: 0.9;
				box-shadow: 0 2px 12px $color1;
			}

			a:not(.current):hover {
				background-color: var(--kira-hover);
			}
		}

		.kira-page-nav > * {
			color: var(--kira-text-4);
			border-radius: $radius;
			width: 35px;
			height: 35px;
			line-height: 35px;
			float: left;
		}

		.kira-posts {
			position: relative;

			.kira-post {
				max-width: 100%;
				transition: 300ms;
				padding: 10px;
				border-radius: 1rem;

				article .aplayer {
					margin: 6px 0 0 0 !important;
				}
			}

			.kira-post:hover {
				background-color: var(--kira-hover);
			}

			.kira-post-meta {
				margin: 10px 0 0 0 !important;
			}

			.kira-post:last-child {
				margin-bottom: $gutter;
			}

			.kira-hr {
				border-bottom: 1px solid var(--kira-hr);
				height: 0;
				margin-block: 12px;
			}
		}
	}
}

.kira-content::-webkit-scrollbar {
	display: none;
}
