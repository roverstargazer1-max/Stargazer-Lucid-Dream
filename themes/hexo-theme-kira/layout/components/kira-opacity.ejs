<div class="kira-opacity" id="kira-opacity">
	<div class="kira-opacity-panel" id="kira-opacity-panel" hidden>
		<div class="kira-opacity-row">
			<label for="kira-opacity-surface">正文清晰度</label>
			<input
				type="range"
				id="kira-opacity-surface"
				min="40"
				max="100"
				step="1"
				value="78"
			/>
		</div>
		<div class="kira-opacity-row">
			<label for="kira-opacity-bg">背景明显度</label>
			<input
				type="range"
				id="kira-opacity-bg"
				min="0"
				max="100"
				step="1"
				value="45"
			/>
		</div>
		<button type="button" class="kira-opacity-reset" id="kira-opacity-reset">
			恢复默认
		</button>
	</div>
	<button
		type="button"
		class="kira-opacity-toggle mdui-fab mdui-ripple"
		id="kira-opacity-toggle"
		aria-label="调整背景与正文透明度"
		title="调整背景与正文透明度"
		aria-expanded="false"
		aria-controls="kira-opacity-panel"
	>
		<svg viewBox="0 0 24 24" width="21" height="21" aria-hidden="true" focusable="false">
			<circle
				cx="12"
				cy="12"
				r="9"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
			/>
			<path fill="currentColor" d="M12 3a9 9 0 010 18z" />
		</svg>
	</button>
</div>
