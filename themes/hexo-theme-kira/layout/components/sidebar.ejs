<div class="kira-sidebar" id="sidebar">
	<div class="kira-avatar mdui-ripple">
		<a href="<%= theme.avatar %>" title="<%= config.author || config.title %>">
			<img
				src="<%= theme.avatar %>"
				alt="<%= config.author || config.title %>"
			/>
		</a>
	</div>
	<div class="kira-count">
		<div><span>文章</span><%= site.posts.length %></div>
		<div><span>标签</span><%= site.tags.length %></div>
		<div><span>分类</span><%= site.categories.length %></div>
	</div>
	<div class="kira-list">
		<% for (name in theme.menu) { %>
		<a
			class="kira-list-item mdui-ripple <%= is_current(theme.menu[name][0]) %>"
			href="<%- url_for(theme.menu[name][0]) -%>"
			title="<%= name %>"
		>
			<i
				class="kirafont
					<% if (theme.menu[name][1]) { %>
						<%= theme.menu[name][1] %>
					<% } else { %>
						<%= 'icon-unordered-list' %>
					<% } %>"
			></i>
			<div class="kira-list-item-content">
				<%= name %>
			</div>
		</a>
		<% } %>
	</div>
	<div class="kira-sidebar-appearance">
		<div class="kira-sidebar-appearance-header">
			<span class="kira-sidebar-appearance-title">外观调节</span>
			<button
				type="button"
				class="kira-theme-toggle kira-sidebar-theme-toggle mdui-ripple"
				aria-label="切换昼夜模式"
				title="切换昼夜模式"
				aria-pressed="false"
			>
				<svg
					class="kira-theme-icon kira-theme-icon-moon"
					viewBox="0 0 24 24"
					width="18"
					height="18"
					aria-hidden="true"
					focusable="false"
				>
					<path
						fill="currentColor"
						d="M12 3A7 7 0 0 0 21 12A9 9 0 1 1 12 3Z"
					/>
				</svg>
				<svg
					class="kira-theme-icon kira-theme-icon-sun"
					viewBox="0 0 24 24"
					width="18"
					height="18"
					aria-hidden="true"
					focusable="false"
				>
					<circle cx="12" cy="12" r="4.2" fill="currentColor" />
					<g stroke="currentColor" stroke-width="2" stroke-linecap="round">
						<line x1="12" y1="1.8" x2="12" y2="4" />
						<line x1="12" y1="20" x2="12" y2="22.2" />
						<line x1="1.8" y1="12" x2="4" y2="12" />
						<line x1="20" y1="12" x2="22.2" y2="12" />
						<line x1="4.8" y1="4.8" x2="6.4" y2="6.4" />
						<line x1="17.6" y1="17.6" x2="19.2" y2="19.2" />
						<line x1="4.8" y1="19.2" x2="6.4" y2="17.6" />
						<line x1="17.6" y1="6.4" x2="19.2" y2="4.8" />
					</g>
				</svg>
			</button>
		</div>
		<div class="kira-sidebar-appearance-body">
			<div class="kira-sidebar-appearance-row">
				<div class="kira-sidebar-label-wrap">
					<label for="kira-sidebar-opacity-surface">正文透明度</label>
					<span class="kira-opacity-val" data-val-for="surface">78%</span>
				</div>
				<input
					type="range"
					class="kira-opacity-input"
					id="kira-sidebar-opacity-surface"
					data-target="surface"
					min="40"
					max="100"
					step="1"
					value="78"
				/>
			</div>
			<div class="kira-sidebar-appearance-row">
				<div class="kira-sidebar-label-wrap">
					<label for="kira-sidebar-opacity-bg">背景透明度</label>
					<span class="kira-opacity-val" data-val-for="bg">61%</span>
				</div>
				<input
					type="range"
					class="kira-opacity-input"
					id="kira-sidebar-opacity-bg"
					data-target="bg"
					min="0"
					max="100"
					step="1"
					value="61"
				/>
			</div>
			<button type="button" class="kira-opacity-reset kira-sidebar-opacity-reset" id="kira-sidebar-opacity-reset">
				恢复默认
			</button>
		</div>
	</div>
	<aside id="kira-sidebar">
		<% theme.widgets.forEach(function(widget) {%>
			<%- partial('_widget/' + widget) %>
		<% }) %>
	</aside>
	<div class="kira-copyright">
		&copy; <%= date(new Date(), 'YYYY') %>
		<a href="<%- url_for('/') %>"><%= config.author || config.title %></a>
		<%= __('Powered by') %> <a href="http://hexo.io/" target="_blank">Hexo</a> &
		<a href="https://github.com/ch1ny/kira-hexo/" target="_blank">Kira-Hexo</a>
		<br />
		<% if (theme.beian) { %>
			<a
				href="https://beian.miit.gov.cn/"
				target="_blank"
			>
				<%= theme.beian %>
			</a>
		<% } %>
		<%- theme.sidebar %>
	</div>
</div>
<div
	class="kira-sidebar-modal"
	id="sidebar-modal"
	onclick="(function(self) {
		self.classList.remove('show');
		document.querySelector('.kira-sidebar.show#sidebar').classList.remove('show');
	})(this)"
></div>