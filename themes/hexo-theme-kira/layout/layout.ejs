<!DOCTYPE html>
<html <% if (config.language) { %>
	lang="<%- config.language %>"<% } %>>
	<head>
		<meta charset="UTF-8" />
		<meta http-equiv="X-UA-Compatible" content="IE=edge" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<% var bgDay = theme.background.path;
		   var bgNight = (theme.backgroundDark && theme.backgroundDark.path) || bgDay;
		   var bgDayMobile = (theme.background.mobilePath || bgDay);
		   var bgNightMobile = (theme.backgroundDark && theme.backgroundDark.mobilePath) || bgDayMobile;
		   var isHomepage = is_home();
		   var needsHighlight = is_post(); %>
		<!-- 昼夜模式和首屏背景预加载必须早于样式表，避免背景等 CSS 解析后才开始请求 -->
		<script>
			(function () {
				var KEY = 'kira-theme';
				var stored = null;
				try {
					stored = localStorage.getItem(KEY);
				} catch (e) {
					/* 隐私模式下读不到就按系统偏好走 */
				}
				var mode =
					stored === 'dark' || stored === 'light'
						? stored
						: window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches
						? 'dark'
						: 'light';
				var background = {
					day: <%- JSON.stringify(bgDay) %>,
					night: <%- JSON.stringify(bgNight) %>,
					dayMobile: <%- JSON.stringify(bgDayMobile) %>,
					nightMobile: <%- JSON.stringify(bgNightMobile) %>
				};
				var isMobile = window.matchMedia && window.matchMedia('(max-width: 767px)').matches;
				var backgroundUrl = mode === 'dark'
					? (isMobile ? background.nightMobile : background.night)
					: (isMobile ? background.dayMobile : background.day);

				document.documentElement.dataset.theme = mode;
				window.__kiraBackground = background;

				<% if (isHomepage) { %>
					var preload = document.createElement('link');
					preload.rel = 'preload';
					preload.as = 'image';
					preload.fetchPriority = 'high';
					preload.href = backgroundUrl;
					preload.setAttribute('data-kira-background-preload', '');
					document.head.appendChild(preload);
				<% } %>
			})();
		</script>
		<%- css("css/layout") %>
		<% var title=page.title; if (is_archive()){ title=__('archive'); if
		(is_month()){ title +='：' + page.year + '/' + page.month; } else if (is_year()){ title
		+='：' + page.year; } } else if (is_category()){ title=__('count.categories') + '：' +
		page.category; } else if (is_tag()){ title=__('count.tags') + '：' + page.tag; } %>
		<title><% if (title){ %> <%= title %> - <% } %> <%= config.title %></title>
		<!-- <link rel="stylesheet" href="https://unpkg.com/mdui@1.0.2/dist/css/mdui.min.css" /> -->
		<%- css("lib/mdui/mdui.min") %>
		<script src="<%- url_for('/lib/mdui/mdui.min.js') %>" defer></script>
		<!-- lazyload -->
		<script src="<%- url_for('/lib/lazysizes.js') %>" defer></script>
		<!-- smooth-scrolling -->
		<script src="<%- url_for('/lib/smooth-scrolling.js') %>" defer></script>
		<!-- highlight -->
		<% if (needsHighlight) { %>
			<%- css("lib/highlight/atom-one-dark.min") %>
			<script src="<%- url_for('/lib/highlight/highlight.min.js') %>" defer></script>
		<% } %>
		<!-- 预置 kiraicon -->
		<%- css("lib/iconfont/iconfont") %>
		<% if (theme.iconlib) { %>
			<link rel="stylesheet" href="<%= theme.iconlib %>" crossorigin />
		<% } %>
		<link
			rel="shortcut icon"
			href="<%= theme.favicon.href %>"
			type="<%= theme.favicon.type %>"
		/>
		<% if (theme.customStyles) { %>
			<% theme.customStyles.forEach(function(customCss){ %>
				<%- css(customCss) %>
			<% }) %>
		<% } %>
		<!-- 昼夜切换与透明度调节不阻塞 HTML 解析；脚本仍按文档顺序执行 -->
		<script src="<%- url_for('/js/kira-theme.js') %>" defer></script>
		<script src="<%- url_for('/js/kira-opacity.js') %>" defer></script>
		<script src="<%- url_for('/js/kira-deferred.js') %>" defer></script>
	</head>

	<body>
		<div
			class="kira-background"
			data-bg-day="<%= bgDay %>"
			data-bg-night="<%= bgNight %>"
			data-bg-day-mobile="<%= bgDayMobile %>"
			data-bg-night-mobile="<%= bgNightMobile %>"
		>
			<img class="kira-background-image" alt="" aria-hidden="true" decoding="async" fetchpriority="high" />
		</div>
		<%- include("components/header") %>
		<div class="kira-body">
			<%- include("components/sidebar") %>
			<div class="kira-content">
				<div id="kira-top-header"></div>
				<div class="kira-main-content">
					<%- body %>
				</div>
			</div>
			<%- include("components/right-column") %>
		</div>
	</body>
</html>
